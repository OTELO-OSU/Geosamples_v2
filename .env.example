# --- Base de données ---
POSTGRES_DB=geosamples
POSTGRES_USER=geosamples
POSTGRES_PASSWORD=à-changer

# --- Symfony ---
APP_SECRET=générer-avec-openssl-rand-hex-32
JWT_PASSPHRASE=générer-avec-openssl-rand-hex-32
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Hôtes acceptés (regex) : tous les sous-domaines OTELo + localhost
TRUSTED_HOSTS='^(.+\.)?otelo\.univ-lorraine\.fr$|^localhost$'
# nginx du conteneur et reverse proxy Apache de l'hôte
TRUSTED_PROXIES=private_ranges
CORS_ALLOW_ORIGIN='^https://([a-z0-9-]+\.)?otelo\.univ-lorraine\.fr$'
COOKIE_SECURE=1
REFRESH_TOKEN_TTL=1209600
UPLOAD_DIR=%kernel.project_dir%/var/uploads
MAX_UPLOAD_BYTES=524288000
MAILER_DSN=smtp://smtp.univ-lorraine.fr:25
MAIL_FROM=noreply-geosamples@univ-lorraine.fr
HTTP_PORT=57010

# Site servi quand le nom d'hôte ne correspond à aucun site (vide = portail des sites)
DEFAULT_SITE=

# --- Fédération RENATER : none | oidc | shibboleth (voir docs/federation.md) ---
FEDERATION_MODE=oidc
OIDC_ISSUER=https://sso.otelo.univ-lorraine.fr/realms/otelo
OIDC_CLIENT_ID=geosamples
OIDC_CLIENT_SECRET=à-changer
OIDC_SCOPES="openid email profile"
# Mode shibboleth : noms des en-têtes posés par mod_shib, et secret partagé exigé
SHIB_HEADERS='{"id":"eppn","email":"mail","firstname":"givenname","lastname":"sn","affiliation":"o"}'
SHIB_SHARED_SECRET=
