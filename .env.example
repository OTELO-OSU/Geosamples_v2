# --- Database ---
POSTGRES_DB=geosamples
POSTGRES_USER=geosamples
# The password is set on the FIRST initialization of docker_data/postgres:
# changing it afterward has no effect on the database (see docs/deploiement.md).
POSTGRES_PASSWORD=change-me

# --- Symfony ---
APP_SECRET=generate-with-openssl-rand-hex-32
JWT_PASSPHRASE=generate-with-openssl-rand-hex-32
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Accepted hosts (regex): all OTELo subdomains + localhost
TRUSTED_HOSTS='^(.+\.)?otelo\.univ-lorraine\.fr$|^localhost$'
# Container nginx and host Apache reverse proxy
TRUSTED_PROXIES=private_ranges
CORS_ALLOW_ORIGIN='^https://([a-z0-9-]+\.)?otelo\.univ-lorraine\.fr$'
COOKIE_SECURE=1
REFRESH_TOKEN_TTL=1209600
UPLOAD_DIR=%kernel.project_dir%/var/uploads
MAX_UPLOAD_BYTES=524288000
MAILER_DSN=smtp://smtp.univ-lorraine.fr:25
MAIL_FROM=noreply-geosamples@univ-lorraine.fr
HTTP_PORT=57010

# Site served when the hostname does not match any site (empty = site portal)
DEFAULT_SITE=

# --- RENATER federation: none | oidc | shibboleth (see docs/federation.md) ---
FEDERATION_MODE=oidc
OIDC_ISSUER=https://sso.otelo.univ-lorraine.fr/realms/otelo
OIDC_CLIENT_ID=geosamples
OIDC_CLIENT_SECRET=change-me
OIDC_SCOPES="openid email profile"
# ORCID sign-in (optional; the client must allow the callback URL)
ORCID_DOMAIN=orcid.org
# Redirect URI registered with ORCID: /orcid (frontend route that forwards to /api/auth/orcid/callback)
ORCID_CLIENT_REDIRECT_URI=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Shibboleth mode: mod_shib header names and required shared secret
SHIB_HEADERS='{"id":"eppn","email":"mail","firstname":"givenname","lastname":"sn","affiliation":"o"}'
SHIB_SHARED_SECRET=
